DEFINE
  Alert := 0;
  None := 1;
  Safe := 2;
  TAlert := 3;
  TWarning := 4;
  Warning := 5;

  output := case
    state = s0 : Safe;
    state = s1 : Warning;
    state = s2 : Alert;
    state = s3 : Safe;
    state = s4 : Warning;
    state = s5 : Warning;
    state = s6 : Alert;
