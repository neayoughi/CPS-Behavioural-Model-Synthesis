    state = s1 : (input = D_HU_HF | input = D_HU_MF | input = D_MU_HF | input = D_MU_MF | input = N_LU_LF | input = N_MU_MF);
    state = s2 : (input = D_HU_HF | input = D_HU_MF | input = D_MU_HF | input = D_MU_MF);
