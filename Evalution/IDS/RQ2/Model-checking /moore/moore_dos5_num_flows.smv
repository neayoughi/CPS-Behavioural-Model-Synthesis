MODULE main

VAR
  state : {s0, s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, s24, s25, s26, s27, s28, s29, s30, s31, s32, s33, s34, s35, s36, s37, s38, s39, s40, s41, s42, s43, s44, s45, s46};
  input : {DH, DL, DM, NH, NL, NM, NO_INPUT};

DEFINE
  Alert := 0;
  None := 1;
  Safe := 2;
  TAlert := 3;
  TWarning := 4;
  Warning := 5;

  output := case
    state = s0 : Safe;
    state = s1 : Warning;
    state = s2 : Alert;
    state = s3 : Safe;
    state = s4 : Warning;
    state = s5 : Alert;
    state = s6 : Safe;
    state = s7 : Warning;
    state = s8 : Alert;
    state = s9 : Safe;
    state = s10 : Warning;
    state = s11 : Alert;
    state = s12 : Warning;
    state = s13 : Warning;
    state = s14 : Warning;
    state = s15 : Warning;
    state = s16 : Warning;
    state = s17 : TWarning;
    state = s18 : TAlert;
    state = s19 : TAlert;
    state = s20 : TAlert;
    state = s21 : TAlert;
    state = s22 : TAlert;
    state = s23 : TAlert;
    state = s24 : TAlert;
    state = s25 : Alert;
    state = s26 : Alert;
    state = s27 : Alert;
    state = s28 : Alert;
    state = s29 : Alert;
    state = s30 : Alert;
    state = s31 : Alert;
    state = s32 : Alert;
    state = s33 : Alert;
    state = s34 : Alert;
    state = s35 : Warning;
    state = s36 : Warning;
    state = s37 : TWarning;
    state = s38 : TAlert;
    state = s39 : Warning;
    state = s40 : Alert;
    state = s41 : Warning;
    state = s42 : Warning;
    state = s43 : Warning;
    state = s44 : Warning;
    state = s45 : Warning;
    state = s46 : TWarning;
  esac;

ASSIGN
  init(state) := s0;

INVAR
  case
    state = s0 : (input = DL | input = DM | input = NL);
    state = s1 : (input = DH | input = DM | input = NL | input = NM);
    state = s2 : (input = DH | input = DM);
    state = s3 : (input = DL | input = DM | input = NL);
    state = s4 : (input = DH | input = DM | input = NL | input = NM);
    state = s5 : (input = DH | input = DM);
    state = s6 : (input = DL | input = DM | input = NL);
    state = s7 : (input = DH | input = DM | input = NL | input = NM);
    state = s8 : (input = DH | input = DM);
    state = s9 : (input = DL | input = DM | input = NL);
    state = s10 : (input = DH | input = DM);
    state = s11 : (input = DH | input = DM);
    state = s12 : input = DM;
    state = s13 : input = DM;
    state = s14 : input = DM;
    state = s15 : input = DM;
    state = s16 : input = DM;
    state = s17 : (input = DH | input = DM);
    state = s18 : (input = DH | input = DM);
    state = s19 : input = DH;
    state = s20 : input = DH;
    state = s21 : input = DH;
    state = s22 : input = DH;
    state = s23 : input = DH;
    state = s24 : input = DH;
    state = s25 : input = DH;
    state = s26 : input = DH;
    state = s27 : (input = DH | input = DM);
    state = s28 : (input = DH | input = DM);
    state = s29 : input = DH;
    state = s30 : (input = DH | input = DM);
    state = s31 : input = DH;
    state = s32 : input = DH;
    state = s33 : input = DH;
    state = s34 : input = DH;
    state = s35 : input = DM;
    state = s36 : input = DM;
    state = s37 : (input = DH | input = DM);
    state = s38 : input = DH;
    state = s39 : (input = DH | input = DM);
    state = s40 : (input = DH | input = DM);
    state = s41 : input = DM;
    state = s42 : input = DM;
    state = s43 : input = DM;
    state = s44 : input = DM;
    state = s45 : input = DM;
    state = s46 : (input = DH | input = DM);
  esac;

TRANS
  case
    state = s0 & input = NL : next(state) = s0;
    state = s0 & input = DL : next(state) = s0;
    state = s0 & input = DM : next(state) = s1;
    state = s1 & input = DM : next(state) = s1;
    state = s1 & input = DH : next(state) = s2;
    state = s1 & input = NM : next(state) = s1;
    state = s1 & input = NL : next(state) = s3;
    state = s2 & input = DH : next(state) = s2;
    state = s2 & input = DM : next(state) = s1;
    state = s3 & input = NL : next(state) = s3;
    state = s3 & input = DL : next(state) = s3;
    state = s3 & input = DM : next(state) = s4;
    state = s4 & input = DM : next(state) = s4;
    state = s4 & input = DH : next(state) = s5;
    state = s4 & input = NM : next(state) = s4;
    state = s4 & input = NL : next(state) = s6;
    state = s5 & input = DH : next(state) = s5;
    state = s5 & input = DM : next(state) = s4;
    state = s6 & input = NL : next(state) = s6;
    state = s6 & input = DL : next(state) = s6;
    state = s6 & input = DM : next(state) = s7;
    state = s7 & input = DM : next(state) = s7;
    state = s7 & input = DH : next(state) = s8;
    state = s7 & input = NM : next(state) = s7;
    state = s7 & input = NL : next(state) = s9;
    state = s8 & input = DH : next(state) = s8;
    state = s8 & input = DM : next(state) = s7;
    state = s9 & input = NL : next(state) = s9;
    state = s9 & input = DL : next(state) = s9;
    state = s9 & input = DM : next(state) = s10;
    state = s10 & input = DM : next(state) = s10;
    state = s10 & input = DH : next(state) = s11;
    state = s11 & input = DH : next(state) = s11;
    state = s11 & input = DM : next(state) = s12;
    state = s12 & input = DM : next(state) = s13;
    state = s13 & input = DM : next(state) = s14;
    state = s14 & input = DM : next(state) = s15;
    state = s15 & input = DM : next(state) = s16;
    state = s16 & input = DM : next(state) = s17;
    state = s17 & input = DM : next(state) = s17;
    state = s17 & input = DH : next(state) = s18;
    state = s18 & input = DH : next(state) = s19;
    state = s18 & input = DM : next(state) = s35;
    state = s19 & input = DH : next(state) = s20;
    state = s20 & input = DH : next(state) = s21;
    state = s21 & input = DH : next(state) = s22;
    state = s22 & input = DH : next(state) = s23;
    state = s23 & input = DH : next(state) = s24;
    state = s24 & input = DH : next(state) = s25;
    state = s25 & input = DH : next(state) = s26;
    state = s26 & input = DH : next(state) = s27;
    state = s27 & input = DH : next(state) = s28;
    state = s27 & input = DM : next(state) = s39;
    state = s28 & input = DH : next(state) = s29;
    state = s28 & input = DM : next(state) = s1;
    state = s29 & input = DH : next(state) = s30;
    state = s30 & input = DH : next(state) = s31;
    state = s30 & input = DM : next(state) = s13;
    state = s31 & input = DH : next(state) = s32;
    state = s32 & input = DH : next(state) = s33;
    state = s33 & input = DH : next(state) = s34;
    state = s34 & input = DH : next(state) = s18;
    state = s35 & input = DM : next(state) = s36;
    state = s36 & input = DM : next(state) = s37;
    state = s37 & input = DM : next(state) = s37;
    state = s37 & input = DH : next(state) = s38;
    state = s38 & input = DH : next(state) = s18;
    state = s39 & input = DM : next(state) = s39;
    state = s39 & input = DH : next(state) = s40;
    state = s40 & input = DH : next(state) = s40;
    state = s40 & input = DM : next(state) = s41;
    state = s41 & input = DM : next(state) = s42;
    state = s42 & input = DM : next(state) = s43;
    state = s43 & input = DM : next(state) = s44;
    state = s44 & input = DM : next(state) = s45;
    state = s45 & input = DM : next(state) = s46;
    state = s46 & input = DM : next(state) = s46;
    state = s46 & input = DH : next(state) = s21;
    TRUE : FALSE;
  esac;

-- Low P1 AG
SPEC AG ((input = DL & output = Safe) -> AX ((output = Warning | output = TWarning)))
-- Low P1 EF-vacuity
SPEC EF (input = DL & output = Safe)
-- Low P2 AG
SPEC AG ((input = DL & output = Warning) -> AX ((output = Alert | output = TAlert)))
-- Low P2 EF-vacuity
SPEC EF (input = DL & output = Warning)
-- Low P3 AG
SPEC AG ((input = DL & output = Alert) -> AX ((output = Alert | output = TAlert)))
-- Low P3 EF-vacuity
SPEC EF (input = DL & output = Alert)
-- Low P4 AG
SPEC AG ((input = NL & output = Safe) -> AX (output = Safe))
-- Low P4 EF-vacuity
SPEC EF (input = NL & output = Safe)
-- Low P5 AG
SPEC AG ((input = NL & output = Warning) -> AX (output = Safe))
-- Low P5 EF-vacuity
SPEC EF (input = NL & output = Warning)
-- Low P6 AG
SPEC AG ((input = NL & output = Alert) -> AX ((output = Warning | output = TWarning)))
-- Low P6 EF-vacuity
SPEC EF (input = NL & output = Alert)
-- Med P1 AG
SPEC AG ((input = DM & output = Safe) -> AX ((output = Warning | output = TWarning)))
-- Med P1 EF-vacuity
SPEC EF (input = DM & output = Safe)
-- Med P2 AG
SPEC AG ((input = DM & output = Warning) -> AX ((output = Alert | output = TAlert)))
-- Med P2 EF-vacuity
SPEC EF (input = DM & output = Warning)
-- Med P3 AG
SPEC AG ((input = DM & output = Alert) -> AX ((output = Alert | output = TAlert)))
-- Med P3 EF-vacuity
SPEC EF (input = DM & output = Alert)
-- Med P4 AG
SPEC AG ((input = NM & output = Safe) -> AX (output = Safe))
-- Med P4 EF-vacuity
SPEC EF (input = NM & output = Safe)
-- Med P5 AG
SPEC AG ((input = NM & output = Warning) -> AX (output = Safe))
-- Med P5 EF-vacuity
SPEC EF (input = NM & output = Warning)
-- Med P6 AG
SPEC AG ((input = NM & output = Alert) -> AX ((output = Warning | output = TWarning)))
-- Med P6 EF-vacuity
SPEC EF (input = NM & output = Alert)
-- High P1 AG
SPEC AG ((input = DH & output = Safe) -> AX ((output = Warning | output = TWarning)))
-- High P1 EF-vacuity
SPEC EF (input = DH & output = Safe)
-- High P2 AG
SPEC AG ((input = DH & output = Warning) -> AX ((output = Alert | output = TAlert)))
-- High P2 EF-vacuity
SPEC EF (input = DH & output = Warning)
-- High P3 AG
SPEC AG ((input = DH & output = Alert) -> AX ((output = Alert | output = TAlert)))
-- High P3 EF-vacuity
SPEC EF (input = DH & output = Alert)
-- High P4 AG
SPEC AG ((input = NH & output = Safe) -> AX (output = Safe))
-- High P4 EF-vacuity
SPEC EF (input = NH & output = Safe)
-- High P5 AG
SPEC AG ((input = NH & output = Warning) -> AX (output = Safe))
-- High P5 EF-vacuity
SPEC EF (input = NH & output = Warning)
-- High P6 AG
SPEC AG ((input = NH & output = Alert) -> AX ((output = Warning | output = TWarning)))
-- High P6 EF-vacuity
SPEC EF (input = NH & output = Alert)

-- MAPPINGS
-- state_map: {"s0": "s0", "s1": "s1", "s10": "s10", "s11": "s11", "s12": "s12", "s13": "s13", "s14": "s14", "s15": "s15", "s16": "s16", "s17": "s17", "s18": "s18", "s19": "s19", "s2": "s2", "s20": "s20", "s21": "s21", "s22": "s22", "s23": "s23", "s24": "s24", "s25": "s25", "s26": "s26", "s27": "s27", "s28": "s28", "s29": "s29", "s3": "s3", "s30": "s30", "s31": "s31", "s32": "s32", "s33": "s33", "s34": "s34", "s35": "s35", "s36": "s36", "s37": "s37", "s38": "s38", "s39": "s39", "s4": "s4", "s40": "s40", "s41": "s41", "s42": "s42", "s43": "s43", "s44": "s44", "s45": "s45", "s46": "s46", "s5": "s5", "s6": "s6", "s7": "s7", "s8": "s8", "s9": "s9"}
-- input_map: {"DH": "DH", "DL": "DL", "DM": "DM", "NH": "NH", "NL": "NL", "NM": "NM", "NO_INPUT": "NO_INPUT"}
-- output_map: {"Alert": "Alert", "None": "None", "Safe": "Safe", "TAlert": "TAlert", "TWarning": "TWarning", "Warning": "Warning"}
