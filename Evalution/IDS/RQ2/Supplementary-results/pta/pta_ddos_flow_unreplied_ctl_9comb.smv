-- ============================================================
-- CTL properties from the table, plus EF antecedent checks
-- NuSMV uses SPEC for CTL formulas
-- Interpretation:
--   AG false                    -> fail
--   AG true and EF false        -> vacuous
--   AG true and EF true         -> pass
-- ============================================================

-- ===== Table column (LF,LU) =====
-- R1_1 Attack and S, (LF,LU)
SPEC AG ((input = D_LU_LF & output = Safe) -> AX (output = Warning | output = TWarning))
SPEC EF (input = D_LU_LF & output = Safe)

-- R1_2 Attack and W, (LF,LU)
SPEC AG ((input = D_LU_LF & output = Warning) -> AX (output = Alert | output = TAlert))
SPEC EF (input = D_LU_LF & output = Warning)

-- R1_3 Attack and A, (LF,LU)
SPEC AG ((input = D_LU_LF & output = Alert) -> AX (output = Alert | output = TAlert))
SPEC EF (input = D_LU_LF & output = Alert)

