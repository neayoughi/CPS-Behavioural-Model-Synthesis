MODULE main

VAR
  state : {s0, s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, s24, s25, s26, s27, s28, s29, s30, s31, s32, s33, s34, s35, s36, s37, s38, s39, s40, s41, s42, s43, s44, s45};
  input : {D_HU_HF, D_HU_LF, D_HU_MF, D_LU_HF, D_LU_LF, D_LU_MF, D_MU_HF, D_MU_LF, D_MU_MF, NO_INPUT, N_HU_HF, N_HU_LF, N_HU_MF, N_LU_HF, N_LU_LF, N_LU_MF, N_MU_HF, N_MU_LF, N_MU_MF};

DEFINE
  Alert := 0;
  None := 1;
  Safe := 2;
  TAlert := 3;
  TWarning := 4;
  Warning := 5;

  output := case
    state = s0 : Safe;
    state = s1 : Warning;
    state = s2 : Alert;
    state = s3 : Safe;
    state = s4 : Warning;
    state = s5 : Warning;
    state = s6 : Alert;
    state = s7 : Safe;
    state = s8 : Warning;
    state = s9 : Alert;
    state = s10 : Warning;
    state = s11 : Warning;
    state = s12 : Warning;
    state = s13 : Warning;
    state = s14 : Warning;
    state = s15 : TWarning;
    state = s16 : TAlert;
    state = s17 : TAlert;
    state = s18 : TAlert;
    state = s19 : TAlert;
    state = s20 : TAlert;
    state = s21 : TAlert;
    state = s22 : TAlert;
    state = s23 : Alert;
    state = s24 : Warning;
    state = s25 : Warning;
    state = s26 : TWarning;
    state = s27 : TAlert;
    state = s28 : Alert;
    state = s29 : Warning;
    state = s30 : Warning;
    state = s31 : Warning;
    state = s32 : TWarning;
    state = s33 : TAlert;
    state = s34 : TAlert;
    state = s35 : TAlert;
    state = s36 : TAlert;
    state = s37 : Alert;
    state = s38 : Warning;
    state = s39 : Warning;
    state = s40 : Warning;
    state = s41 : Warning;
    state = s42 : TWarning;
    state = s43 : TAlert;
    state = s44 : TAlert;
    state = s45 : TAlert;
  esac;

ASSIGN
  init(state) := s0;

INVAR
  case
    state = s0 : (input = D_LU_LF | input = D_MU_LF | input = D_MU_MF | input = N_LU_LF);
    state = s1 : (input = D_HU_HF | input = D_HU_MF | input = D_MU_HF | input = D_MU_MF | input = N_LU_LF | input = N_MU_MF);
    state = s2 : (input = D_HU_HF | input = D_HU_MF | input = D_MU_HF | input = D_MU_MF);
    state = s3 : (input = D_LU_LF | input = D_MU_MF | input = N_LU_LF);
    state = s4 : (input = D_HU_HF | input = D_HU_MF | input = D_MU_MF | input = N_LU_LF | input = N_MU_MF);
    state = s5 : (input = D_HU_HF | input = D_HU_MF | input = D_MU_MF);
    state = s6 : (input = D_HU_HF | input = D_MU_HF | input = D_MU_MF);
    state = s7 : input = D_MU_MF;
    state = s8 : (input = D_HU_HF | input = D_MU_MF);
    state = s9 : (input = D_HU_HF | input = D_MU_HF | input = D_MU_MF);
    state = s10 : (input = D_HU_HF | input = D_MU_MF);
    state = s11 : input = D_MU_MF;
    state = s12 : input = D_MU_MF;
    state = s13 : input = D_MU_MF;
    state = s14 : input = D_MU_MF;
    state = s15 : (input = D_HU_HF | input = D_HU_MF | input = D_MU_MF);
    state = s16 : (input = D_HU_HF | input = D_MU_MF);
    state = s17 : input = D_HU_HF;
    state = s18 : input = D_HU_HF;
    state = s19 : input = D_HU_HF;
    state = s20 : input = D_HU_HF;
    state = s21 : input = D_HU_HF;
    state = s22 : input = D_HU_HF;
    state = s23 : (input = D_HU_HF | input = D_MU_HF | input = D_MU_MF);
    state = s24 : input = D_MU_MF;
    state = s25 : input = D_MU_MF;
    state = s26 : (input = D_HU_HF | input = D_HU_MF | input = D_MU_MF);
    state = s27 : input = D_HU_HF;
    state = s28 : (input = D_HU_HF | input = D_MU_MF);
    state = s29 : input = D_MU_MF;
    state = s30 : input = D_MU_MF;
    state = s31 : input = D_MU_MF;
    state = s32 : (input = D_HU_HF | input = D_MU_MF);
    state = s33 : input = D_HU_HF;
    state = s34 : input = D_HU_HF;
    state = s35 : input = D_HU_HF;
    state = s36 : input = D_HU_HF;
    state = s37 : (input = D_HU_HF | input = D_MU_HF | input = D_MU_MF);
    state = s38 : input = D_MU_MF;
    state = s39 : input = D_MU_MF;
    state = s40 : input = D_MU_MF;
    state = s41 : input = D_MU_MF;
    state = s42 : (input = D_HU_HF | input = D_MU_MF);
    state = s43 : input = D_HU_HF;
    state = s44 : input = D_HU_HF;
    state = s45 : input = D_HU_HF;
  esac;

TRANS
  case
    state = s0 & input = D_LU_LF : next(state) = s0;
    state = s0 & input = D_MU_LF : next(state) = s3;
    state = s0 & input = D_MU_MF : next(state) = s1;
    state = s0 & input = N_LU_LF : next(state) = s0;
    state = s1 & input = D_HU_HF : next(state) = s2;
    state = s1 & input = D_HU_MF : next(state) = s1;
    state = s1 & input = D_MU_HF : next(state) = s2;
    state = s1 & input = D_MU_MF : next(state) = s1;
    state = s1 & input = N_LU_LF : next(state) = s0;
    state = s1 & input = N_MU_MF : next(state) = s1;
    state = s10 & input = D_HU_HF : next(state) = s28;
    state = s10 & input = D_MU_MF : next(state) = s11;
    state = s11 & input = D_MU_MF : next(state) = s12;
    state = s12 & input = D_MU_MF : next(state) = s13;
    state = s13 & input = D_MU_MF : next(state) = s14;
    state = s14 & input = D_MU_MF : next(state) = s15;
    state = s15 & input = D_HU_HF : next(state) = s16;
    state = s15 & input = D_HU_MF : next(state) = s15;
    state = s15 & input = D_MU_MF : next(state) = s15;
    state = s16 & input = D_HU_HF : next(state) = s17;
    state = s16 & input = D_MU_MF : next(state) = s24;
    state = s17 & input = D_HU_HF : next(state) = s18;
    state = s18 & input = D_HU_HF : next(state) = s19;
    state = s19 & input = D_HU_HF : next(state) = s20;
    state = s2 & input = D_HU_HF : next(state) = s2;
    state = s2 & input = D_HU_MF : next(state) = s1;
    state = s2 & input = D_MU_HF : next(state) = s2;
    state = s2 & input = D_MU_MF : next(state) = s1;
    state = s20 & input = D_HU_HF : next(state) = s21;
    state = s21 & input = D_HU_HF : next(state) = s22;
    state = s22 & input = D_HU_HF : next(state) = s23;
    state = s23 & input = D_HU_HF : next(state) = s23;
    state = s23 & input = D_MU_HF : next(state) = s16;
    state = s23 & input = D_MU_MF : next(state) = s5;
    state = s24 & input = D_MU_MF : next(state) = s25;
    state = s25 & input = D_MU_MF : next(state) = s26;
    state = s26 & input = D_HU_HF : next(state) = s27;
    state = s26 & input = D_HU_MF : next(state) = s32;
    state = s26 & input = D_MU_MF : next(state) = s26;
    state = s27 & input = D_HU_HF : next(state) = s16;
    state = s28 & input = D_HU_HF : next(state) = s28;
    state = s28 & input = D_MU_MF : next(state) = s29;
    state = s29 & input = D_MU_MF : next(state) = s30;
    state = s3 & input = D_LU_LF : next(state) = s7;
    state = s3 & input = D_MU_MF : next(state) = s4;
    state = s3 & input = N_LU_LF : next(state) = s3;
    state = s30 & input = D_MU_MF : next(state) = s31;
    state = s31 & input = D_MU_MF : next(state) = s24;
    state = s32 & input = D_HU_HF : next(state) = s33;
    state = s32 & input = D_MU_MF : next(state) = s32;
    state = s33 & input = D_HU_HF : next(state) = s34;
    state = s34 & input = D_HU_HF : next(state) = s35;
    state = s35 & input = D_HU_HF : next(state) = s36;
    state = s36 & input = D_HU_HF : next(state) = s37;
    state = s37 & input = D_HU_HF : next(state) = s37;
    state = s37 & input = D_MU_HF : next(state) = s2;
    state = s37 & input = D_MU_MF : next(state) = s38;
    state = s38 & input = D_MU_MF : next(state) = s39;
    state = s39 & input = D_MU_MF : next(state) = s40;
    state = s4 & input = D_HU_HF : next(state) = s2;
    state = s4 & input = D_HU_MF : next(state) = s5;
    state = s4 & input = D_MU_MF : next(state) = s4;
    state = s4 & input = N_LU_LF : next(state) = s3;
    state = s4 & input = N_MU_MF : next(state) = s4;
    state = s40 & input = D_MU_MF : next(state) = s41;
    state = s41 & input = D_MU_MF : next(state) = s42;
    state = s42 & input = D_HU_HF : next(state) = s43;
    state = s42 & input = D_MU_MF : next(state) = s42;
    state = s43 & input = D_HU_HF : next(state) = s44;
    state = s44 & input = D_HU_HF : next(state) = s45;
    state = s45 & input = D_HU_HF : next(state) = s33;
    state = s5 & input = D_HU_HF : next(state) = s6;
    state = s5 & input = D_HU_MF : next(state) = s10;
    state = s5 & input = D_MU_MF : next(state) = s5;
    state = s6 & input = D_HU_HF : next(state) = s6;
    state = s6 & input = D_MU_HF : next(state) = s6;
    state = s6 & input = D_MU_MF : next(state) = s4;
    state = s7 & input = D_MU_MF : next(state) = s8;
    state = s8 & input = D_HU_HF : next(state) = s9;
    state = s8 & input = D_MU_MF : next(state) = s8;
    state = s9 & input = D_HU_HF : next(state) = s9;
    state = s9 & input = D_MU_HF : next(state) = s9;
    state = s9 & input = D_MU_MF : next(state) = s10;
    TRUE : TRUE;
  esac;

-- ============================================================
-- CTL properties from the table, plus EF antecedent checks
-- NuSMV uses SPEC for CTL formulas
-- Interpretation:
--   AG false                    -> fail
--   AG true and EF false        -> vacuous
--   AG true and EF true         -> pass
-- ============================================================

-- ===== Table column (LF,LU) =====
-- R1_1 Attack and S, (LF,LU)
SPEC AG ((input = D_LU_LF & output = Safe) -> AX (output = Warning | output = TWarning))
SPEC EF (input = D_LU_LF & output = Safe)

-- R1_2 Attack and W, (LF,LU)
SPEC AG ((input = D_LU_LF & output = Warning) -> AX (output = Alert | output = TAlert))
SPEC EF (input = D_LU_LF & output = Warning)

-- R1_3 Attack and A, (LF,LU)
SPEC AG ((input = D_LU_LF & output = Alert) -> AX (output = Alert | output = TAlert))
SPEC EF (input = D_LU_LF & output = Alert)

-- R2_1 Normal and S, (LF,LU)
SPEC AG ((input = N_LU_LF & output = Safe) -> AX (output = Safe))
SPEC EF (input = N_LU_LF & output = Safe)

-- R2_2 Normal and W, (LF,LU)
